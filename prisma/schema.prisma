generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id              String           @id @default(uuid())
  name            String           @unique
  discountRate    Float            @default(0)
  isActive        Boolean          @default(true)
  defaultImageUrl String           @default("https://example.com/default-brand-img.jpg")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  desc            String          @default("desc")
  y_weight        String           @default("")
  weight_g        Int              @default(1)
  category        String           @default("")
  products        Product[]
   
}

model Product {
  id              String      @id @default(uuid())
  pname           String
  brandId         String
  brand           Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  originalPrice   Int
  discountedPrice Int

  Shown           Boolean     @default(true)
  irul            String
  desc            String
  y_weight        String
  weight_g        Int
  category        String
  stock           Int
  color           String
  isYarn          Boolean     @default(true)

  orderItems      OrderItem[]
}

model YarnAccessory {
  id              String      @id @default(uuid())
  name            String
 
  originalPrice   Int
  discountedPrice Int
  isActive        Boolean     @default(true)
  imageUrl        String
  description     String
  category        String
  stock           Int
 createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems      OrderItem[]
}

model User {
  id      String  @id @default(uuid())
  name    String
  phone   String  @unique
  Address String
  pincode String
  orders  Order[]
}

model Order {
  id         String      @id @default(uuid())
  pricepaid  Int
  createdAt  DateTime    @default(now())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  paymentid  String
  paid       Boolean     @default(false)
  orderItems OrderItem[]
  complete   Boolean     @default(false)
  delivered  Boolean     @default(false)
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  productId       String?
  yarnAccessoryId String?
  quantity        Int

  order           Order          @relation(fields: [orderId], references: [id])
  product         Product?       @relation(fields: [productId], references: [id])
  yarnAccessory   YarnAccessory? @relation(fields: [yarnAccessoryId], references: [id])
}
